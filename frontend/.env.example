# Backend API
NEXT_PUBLIC_API_ROOT=https://your-api-url/
NEXT_PUBLIC_API_TOKEN=Bearer your-api-token
# Optional: URL server-side code (SSR, API routes) uses to reach the backend
# when it differs from the browser URL — e.g. http://boilerworks-local:8000
# inside the docker-compose ui container. Falls back to NEXT_PUBLIC_API_ROOT.
# API_ROOT_INTERNAL=

# Auth — no Auth0 vars needed here. Login redirects to the backend
# (${NEXT_PUBLIC_API_ROOT}app/auth1/login), which handles the Auth0 OIDC
# flow server-side and returns a backend-issued token to /auth/callback.
# Auth0 credentials (AUTH0_DOMAIN etc.) live in backend/config/local.env.

# App
NEXT_PUBLIC_MAIN_PAGE='/triage'
APP_BASE_URL='http://localhost:3000'

# Copilot (CopilotKit UI <-> Django Pydantic-AI AG-UI agent)
# Toggle the in-app copilot sidebar. Leave false to ship the app without it.
NEXT_PUBLIC_COPILOT_ENABLED=false
# Optional full-URL override for the Django AG-UI endpoint. When unset the
# runtime derives it from NEXT_PUBLIC_API_ROOT as
# ${NEXT_PUBLIC_API_ROOT}/app/copilot/agui/ (the same /app/ mount as GraphQL).
# Set this only if the endpoint is mounted elsewhere or on a separate host.
# COPILOT_AGUI_URL=http://localhost:8000/app/copilot/agui/
# Optional CopilotKit Cloud public key (cpk-…). NOT required — the runtime is
# self-hosted and the LLM lives in the Django agent. Set only to enable
# Copilot Cloud features during development. Put real keys in .env.local.
# NEXT_PUBLIC_COPILOTKIT_API_KEY=
# CopilotKit Intelligence project key (server-only, never NEXT_PUBLIC_).
# `npx copilotkit@latest project select` writes it to frontend/.env for you.
# Optional: without it the copilot still chats, runs tools and shows the
# approval cards, but has no threads drawer, Automatic Learning or Skills.
CPK_INTELLIGENCE_API_KEY=
# Learning Container in that project (must exist there). Default: triage-demo-2
# COPILOT_LEARNING_CONTAINER_ID=triage-demo-2

# Metabase (optional)
METABASE_SITE_URL=https://your-metabase-url
METABASE_SECRET_KEY=your-metabase-secret-key

# Sentry (optional)
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ORG=