# Keep this flag: the committed package-lock.json was resolved with legacy-peer-deps,
# so `npm ci` needs it to reproduce that exact tree. Without it, `npm ci` aborts with
# ~40 transitive deps (the webpack build toolchain, etc.) reported "missing from lock
# file" — the strict-resolution ideal tree differs from the committed lock.
#
# NOTE: the original rationale ("openai@4 pins zod@^3") is STALE — there is no live
# openai/zod conflict to pin with a per-edge override. @copilotkit/runtime@1.63.1
# depends on openai "^4.85.1 || >=5.0.0", which resolves to openai@6 (optional peer
# zod "^3.25 || ^4.0"), fully compatible with this app's zod@4. Fully dropping this
# flag is possible but only by regenerating the lockfile (a ~197-package add incl. a
# unified 10 -> 11 bump), which is out of scope for the copilot review.
legacy-peer-deps=true
